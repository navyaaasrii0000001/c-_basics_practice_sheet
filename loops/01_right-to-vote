#include <iostream>
using namespace std;

int main() {
    int n, age;

    cout << "Enter number of people: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        cout << "Enter age of person " << i << ": ";
        cin >> age;

        if (age >= 18) {
            cout << "Eligible to vote" << endl;
        } else {
            cout << "Not eligible to vote" << endl;
        }
    }

    return 0;
}
