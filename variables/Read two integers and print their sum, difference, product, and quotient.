#include <iostream>
using namespace std;

int sum(int a,int b)
{
    return a+b;
}
int difference(int a,int b)
{
    return a-b;
}
int product(int a,int b)
{
    return a*b;
}
double quotient(int a,int b)
{
  return static_cast<double>(a) /b;
 

}
int main(){
  cout<<sum(2,5)<<"\n";
  cout<<difference(2,5)<<"\n";
  cout<<product(2,5)<<"\n";
  cout<<quotient(2,5);
  return 0;
}
